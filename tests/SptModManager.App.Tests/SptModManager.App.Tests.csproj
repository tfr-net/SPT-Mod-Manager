<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SptModManager.App\SptModManager.App.csproj" />
    <ProjectReference Include="..\Fixtures\FakeSptServerCore\FakeSptServerCore.csproj" />
    <ProjectReference Include="..\Fixtures\FakeClientPlugin\FakeClientPlugin.csproj" />
    <ProjectReference Include="..\Fixtures\FakeServerMod\FakeServerMod.csproj" />
    <ProjectReference Include="..\Fixtures\FakeServerModGetters\FakeServerModGetters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the core tests' temp-install builder and fakes. -->
    <Compile Include="..\SptModManager.Core.Tests\Support\*.cs" LinkBase="Support" />
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

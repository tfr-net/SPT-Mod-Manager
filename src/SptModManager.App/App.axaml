<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SptModManager.App.App"
             xmlns:local="using:SptModManager.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#14161A" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#191C21" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2227" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262B32" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#30363E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D4A63A" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#E2B752" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#B88D2A" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#16181B" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#96A0AB" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#78C27C" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E3AA45" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E5675F" />
        <SolidColorBrush x:Key="InfoBrush" Color="#63AEE8" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#D4A63A" RegionColor="#14161A" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
